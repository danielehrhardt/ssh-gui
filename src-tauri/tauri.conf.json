{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Key Manager",
  "version": "0.1.0",
  "identifier": "io.github.danielehrhardt.sshkm",
  "build": {
    "beforeDevCommand": "node scripts/build-sidecar.mjs --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSH Key Manager",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Manage your local SSH keys",
    "longDescription": "List, generate, import, rename, enable/disable and delete the SSH keys in ~/.ssh — with a CLI and MCP server for AI assistants.",
    "copyright": "© 2026 Daniel Ehrhardt",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sshkm"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
